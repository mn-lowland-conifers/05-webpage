---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/paths';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Mapping peatland carbon probability, depth, and stock across Minnesota.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<link rel="icon" href={withBase('favicon.ico')} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title} | MN Peatland Carbon Mapping</title>
	</head>
	<body>
		<Nav />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--ink: #292929;
		--muted: #2e2e2e;
		--accent: #333333;
		--border: #454545;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	body {
		font-family: 'Open Sans', Arial, Helvetica, sans-serif;
		color: var(--muted);
		background: #ffffff;
		display: flex;
		flex-direction: column;
	}

	main {
		flex: 1;
		max-width: 960px;
		width: 100%;
		margin: 0 auto;
		padding: 2.5rem 1.5rem;
		box-sizing: border-box;
	}

	h1,
	h2,
	h3 {
		color: var(--ink);
		font-weight: 400;
		line-height: 1.2;
	}

	p {
		color: var(--muted);
		line-height: 1.6;
	}

	a {
		color: var(--muted);
	}

	.button-row {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.button {
		display: inline-block;
		background: var(--accent);
		color: #ffffff;
		text-decoration: none;
		border-radius: 4px;
		padding: 0.68rem 1.08rem;
		font-size: 0.95rem;
	}

	.button:hover {
		background: #1a1a1a;
	}
</style>
