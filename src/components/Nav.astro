---
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/map/', label: 'Map' },
	{ href: '/database/', label: 'Database' },
	{ href: '/resources/', label: 'Resources' },
];

const path = Astro.url.pathname;
function isActive(href: string) {
	if (href === '/') return path === '/' || path === '';
	return path.startsWith(href);
}
---

<header>
	<nav>
		<a class="brand" href="/">MN Peatland Carbon Mapping</a>
		<ul>
			{
				links.map((link) => (
					<li>
						<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	header {
		border-bottom: 1px solid #e2e8e4;
		background: #ffffff;
	}

	nav {
		max-width: 960px;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.brand {
		font-weight: 700;
		font-size: 1.1rem;
		color: #1f3d2b;
		text-decoration: none;
	}

	ul {
		list-style: none;
		display: flex;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
	}

	a {
		color: #35543f;
		text-decoration: none;
		font-size: 0.95rem;
	}

	ul a:hover {
		color: #16311f;
	}

	ul a[aria-current='page'] {
		color: #16311f;
		font-weight: 600;
		border-bottom: 2px solid #4c8c5f;
	}
</style>
