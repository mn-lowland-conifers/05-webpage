---
import { Image } from 'astro:assets';
import badge from '../assets/lowland-conifer-badge.png';
import textLogo from '../assets/mnlcc-text-logo.png';
import { withBase } from '../utils/paths';

const MAP_VIEWER_URL = 'https://maps.mnlowlandconifercarbon.org/';
const DOCS_URL = 'https://mn-lowland-conifers.github.io/03-peatland-carbon-modeling/';

const links = [
	{ href: withBase(''), label: 'Home' },
	{ href: MAP_VIEWER_URL, label: 'Map', external: true },
	{ href: withBase('database/'), label: 'Database' },
	{ href: DOCS_URL, label: 'Documentation', external: true },
];

const path = Astro.url.pathname;
function isActive(href: string) {
	if (href.startsWith('http')) return false;
	if (href === withBase('')) return path === href;
	return path.startsWith(href);
}
---

<header class="site-header">
	<nav class="nav-container" aria-label="Primary navigation">
		<a class="brand" href={withBase('')} aria-label="MN Peatland Carbon Mapping home">
			<Image class="badge" src={badge} alt="" height={192} />
			<Image class="text-logo" src={textLogo} alt="MNLCC: Minnesota Peatland Carbon Mapping" height={160} />
		</a>
		<div class="links">
			{
				links.map((link) => (
					<a
						href={link.href}
						aria-current={isActive(link.href) ? 'page' : undefined}
						target={link.external ? '_blank' : undefined}
						rel={link.external ? 'noopener noreferrer' : undefined}
					>
						{link.label}
					</a>
				))
			}
		</div>
	</nav>
</header>

<style>
	.site-header {
		background: #ffffff;
		border-bottom: 1px solid #454545;
	}

	.nav-container {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 2rem;
		width: min(100% - 2rem, 960px);
		min-height: 118px;
		margin-inline: auto;
		padding: 0.75rem 0 0.65rem;
		box-sizing: border-box;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		flex: none;
		line-height: 0;
		text-decoration: none;
	}

	.badge {
		height: 96px;
		width: auto;
		display: block;
	}

	.text-logo {
		height: 80px;
		width: auto;
		display: block;
	}

	.links {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 1.05rem;
	}

	.links a {
		color: #272727;
		white-space: nowrap;
		font-size: 1.1rem;
		font-weight: 400;
		line-height: 1.2;
		text-decoration: none;
	}

	.links a:hover,
	.links a:focus-visible {
		color: #000000;
	}

	.links a[aria-current='page'] {
		font-weight: 600;
	}

	@media (width <= 760px) {
		.nav-container {
			flex-direction: column;
			align-items: center;
			gap: 0.9rem;
			min-height: auto;
			padding-block: 1rem;
		}

		.badge {
			height: 72px;
		}

		.text-logo {
			height: 60px;
		}

		.links {
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.7rem 1.1rem;
		}

		.links a {
			font-size: 1rem;
		}
	}
</style>
