---
import { Image } from 'astro:assets';
import badge from '../assets/lowland-conifer-badge.png';
import { withBase } from '../utils/paths';

const MAP_VIEWER_URL = 'https://maps.mnlowlandconifercarbon.org/';
const DOCS_URL = 'https://mn-lowland-conifers.github.io/03-peatland-carbon-modeling/';

const links = [
	{ href: withBase(''), label: 'Home' },
	{ href: withBase('database/'), label: 'Database' },
];

const path = Astro.url.pathname;
function isActive(href: string) {
	if (href === withBase('')) return path === href;
	return path.startsWith(href);
}
---

<header>
	<nav>
		<a class="brand" href={withBase('')}>
			<Image src={badge} alt="MN Lowland Conifers" width={40} height={40} />
			MN Peatland Carbon Mapping
		</a>
		<ul>
			<li>
				<a href={MAP_VIEWER_URL} target="_blank" rel="noopener noreferrer">Map</a>
			</li>
			{
				links.map((link) => (
					<li>
						<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
							{link.label}
						</a>
					</li>
				))
			}
			<li>
				<a href={DOCS_URL} target="_blank" rel="noopener noreferrer">Documentation</a>
			</li>
		</ul>
	</nav>
</header>

<style>
	header {
		border-bottom: 1px solid #454545;
		background: #ffffff;
	}

	nav {
		max-width: 960px;
		margin: 0 auto;
		padding: 1.1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 400;
		font-size: 1.15rem;
		color: #292929;
		text-decoration: none;
	}

	.brand img {
		border-radius: 50%;
		object-fit: cover;
	}

	ul {
		list-style: none;
		display: flex;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
	}

	a {
		color: #2e2e2e;
		text-decoration: none;
		font-size: 1rem;
	}

	ul a:hover {
		color: #000000;
	}

	ul a[aria-current='page'] {
		font-weight: 600;
	}
</style>
