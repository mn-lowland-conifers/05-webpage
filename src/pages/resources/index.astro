---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Resources" description="Methods, documentation, and background for the peatland carbon mapping project.">
	<h1>Resources</h1>
	<p>
		Documentation and background material supporting the maps and database, including methods
		summaries and citations.
	</p>

	<div class="button-row">
		<a class="button" href="https://mn-lowland-conifers.github.io/03-peatland-carbon-modeling/">Read the Methods Documentation</a>
	</div>

	<section class="placeholder">
		<p>Citation info and links to related publications go here.</p>
	</section>

	<style>
		.button-row {
			margin-top: 1.5rem;
		}

		.button {
			display: inline-block;
			background: var(--accent);
			color: #ffffff;
			text-decoration: none;
			border-radius: 4px;
			padding: 0.68rem 1.08rem;
			font-size: 0.95rem;
		}

		.button:hover {
			background: #1a1a1a;
		}

		.placeholder {
			margin-top: 1.5rem;
			padding: 2rem;
			border: 1px dashed #c7d2cb;
			border-radius: 12px;
			background: #ffffff;
			text-align: center;
		}
	</style>
</Layout>
