---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/paths';
---

<Layout title="Probability Model" description="Modeled probability of peatland occurrence across Minnesota.">
	<p class="breadcrumb"><a href={withBase('map/')}>Map</a> / Probability Model</p>
	<h1>Probability Model</h1>
	<p>
		This model estimates probabiltiy that peat exists at a location, as a percentage from 0-1
	</p>

	<section class="placeholder">
		<p>Map figure</p>
	</section>

	<style>
		.breadcrumb {
			font-size: 0.85rem;
			margin-bottom: 0.5rem;
		}

		.placeholder {
			margin-top: 2rem;
			padding: 2rem;
			border: 1px dashed #c7d2cb;
			border-radius: 12px;
			background: #ffffff;
			text-align: center;
		}
	</style>
</Layout>
