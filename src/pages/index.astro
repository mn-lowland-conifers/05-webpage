---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/paths';
---

<Layout title="Home">
	<section class="hero">
		<header class="hero-heading">
			<h1>Minnesota Peatland Carbon Mapping</h1>
			<p class="tagline">Statewide peatland probability, depth, and carbon stock mapping across Minnesota.</p>

			<div class="buttons">
				<a href="https://maps.mnlowlandconifercarbon.org/" target="_blank" rel="noopener noreferrer">Explore Maps</a>
				<a href={withBase('database/')}>Explore Database</a>
				<a href="https://mn-lowland-conifers.github.io/03-peatland-carbon-modeling/" target="_blank" rel="noopener noreferrer">Read Documentation</a>
			</div>
		</header>

		<figure class="comparison-figure">
			<div class="comparison" data-comparison style="--position: 50%;">
				<img
					class="comparison-image"
					src={withBase('images/hero/satellite.webp')}
					alt="Satellite imagery of a Minnesota peatland landscape"
					width="2000"
					height="1120"
				/>
				<img
					class="comparison-image comparison-overlay"
					src={withBase('images/hero/depth-map.webp')}
					alt="Mapped peat depth for the same Minnesota peatland landscape"
					width="2000"
					height="1119"
				/>
				<span class="panel-label panel-label-left">Predicted peat depth</span>
				<span class="panel-label panel-label-right">Satellite imagery</span>
				<div class="divider" aria-hidden="true">
					<span class="handle">&#8596;</span>
				</div>
				<input
					class="comparison-control"
					type="range"
					min="0"
					max="100"
					value="50"
					aria-label="Compare mapped peat depth with satellite imagery"
				/>
			</div>
			<figcaption>Comparison of the predicted peat depth map (left) against satellite imagery (right)</figcaption>
		</figure>

		<div class="overview">
			<p>
				This website provides access to statewide maps, data, and documentation for the Minnesota
				Lowland Conifer Peatland Carbon project. Maps can be viewed in the MNLCC viewer and include
				peat probability, depth, and carbon layers.
			</p>
		</div>
	</section>

	<script>
		document.querySelectorAll('[data-comparison]').forEach((el) => {
			if (!(el instanceof HTMLElement)) return;
			const control = el.querySelector('.comparison-control');
			if (!(control instanceof HTMLInputElement)) return;
			const update = () => {
				el.style.setProperty('--position', `${control.value}%`);
			};
			control.addEventListener('input', update);
			update();
		});
	</script>

	<section class="framework-section" aria-labelledby="viewer-heading">
		<div class="content-container">
			<h2 id="viewer-heading">MNLCC Viewer</h2>
			<p>
				This is the project's interactive interface for exploring its statewide map products.
				The MNLCC viewer contains a stack of statewide digital soil map products at 10m
				resolution. It includes a peatland probability raster, peat depth raster, and a carbon
				stock raster that estimates full-profile carbon stock derived from the depth model. It
				also contains reference layers including a NLCD derived land cover mask, the predicted
				peat extent at the probability threshold, and a gSSURGO histosol percent of map unit
				layer.
			</p>
			<div class="viewer-gallery">
				<figure>
					<img src={withBase('images/mnlcc-viewer/probability.png')} alt="MNLCC Viewer screenshot of the peatland probability layer" width="517" height="507" loading="lazy" />
				</figure>
				<figure>
					<img src={withBase('images/mnlcc-viewer/depth.png')} alt="MNLCC Viewer screenshot of the predicted peat depth layer" width="517" height="506" loading="lazy" />
				</figure>
				<figure>
					<img src={withBase('images/mnlcc-viewer/carbon.png')} alt="MNLCC Viewer screenshot of the belowground carbon stock layer" width="515" height="508" loading="lazy" />
				</figure>
			</div>
		</div>
	</section>

	<section class="framework-section" aria-labelledby="database-heading">
		<div class="content-container">
			<h2 id="database-heading">Database</h2>
			<p>
				The Database brings together the field observations and training data used to build the
				models. Sources include the Minnesota DNR Peat Inventory, The National Soil Information
				System (NASIS) pedon data, Minnesota Biological Survey relevé data, and 2025 field
				verification data that measured peat depth and collected peat and vegetation samples on
				Minnesota School Trust lands.
			</p>
		</div>
	</section>

	<section class="framework-section" aria-labelledby="documentation-heading">
		<div class="content-container">
			<h2 id="documentation-heading">Documentation</h2>
			<p>
				Full methods documentation for this project is published as the MN Peatland Carbon
				Modeling e-book. It covers the workflow behind the statewide mapping products including
				point and covariate data processing, model training and validation, and results.
			</p>
		</div>
	</section>

	<style>
		.hero {
			padding: 0.4rem 0 2.5rem;
		}

		.hero-heading {
			text-align: center;
		}

		.hero h1 {
			font-family: 'Roboto', Arial, Helvetica, sans-serif;
			font-size: clamp(1.7rem, 3vw, 1.95rem);
			margin-top: 0;
			margin-bottom: 0.4rem;
		}

		.tagline {
			font-style: italic;
			color: #5a5a5a;
			max-width: 760px;
			margin: 0.55rem auto 1.1rem;
		}

		.buttons {
			display: flex;
			justify-content: center;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-bottom: 0;
		}

		.buttons a {
			display: inline-block;
			background: var(--accent);
			color: #ffffff;
			text-decoration: none;
			border-radius: 4px;
			padding: 0.68rem 1.08rem;
			font-size: 0.95rem;
		}

		.buttons a:hover {
			background: #1a1a1a;
		}

		.comparison-figure {
			margin: 1.5rem 0 0;
		}

		.comparison {
			--position: 50%;
			aspect-ratio: 2000 / 1119;
			background: #e8e8e8;
			border: 1px solid var(--border);
			width: 100%;
			position: relative;
			overflow: hidden;
		}

		.comparison-image {
			object-fit: cover;
			user-select: none;
			pointer-events: none;
			width: 100%;
			height: 100%;
			position: absolute;
			inset: 0;
		}

		.comparison-overlay {
			clip-path: inset(0 calc(100% - var(--position)) 0 0);
		}

		.divider {
			top: 0;
			bottom: 0;
			left: var(--position);
			z-index: 3;
			pointer-events: none;
			background: #ffffff;
			width: 2px;
			position: absolute;
			transform: translate(-1px);
		}

		.handle {
			color: #ffffff;
			background: #282828d1;
			border: 2px solid #ffffff;
			border-radius: 50%;
			display: grid;
			place-items: center;
			width: 32px;
			height: 32px;
			font-size: 1rem;
			line-height: 1;
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
		}

		.comparison-control {
			z-index: 4;
			cursor: ew-resize;
			opacity: 0;
			width: 100%;
			height: 100%;
			margin: 0;
			position: absolute;
			inset: 0;
		}

		.panel-label {
			z-index: 2;
			color: #ffffff;
			pointer-events: none;
			background: #191919b8;
			border-radius: 2px;
			padding: 0.28rem 0.5rem;
			font-size: 0.75rem;
			line-height: 1.2;
			position: absolute;
			bottom: 0.65rem;
		}

		.panel-label-left {
			left: 0.65rem;
		}

		.panel-label-right {
			right: 0.65rem;
		}

		figcaption {
			color: #555555;
			text-align: center;
			background: #f1f1f1;
			padding: 0.62rem 1rem;
			font-size: 0.86rem;
			line-height: 1.45;
		}

		.overview {
			border-top: 1px solid #cccccc;
			margin-top: 1.45rem;
			padding-top: 1.25rem;
		}

		.overview p {
			margin: 0;
		}

		.overview ul {
			margin: 1rem 0 1.75rem;
			padding-left: 1.75rem;
		}

		.overview li {
			margin-bottom: 0.25rem;
		}

		.overview li:last-child {
			margin-bottom: 0;
		}

		.overview p + ul {
			margin-top: 1rem;
		}

		@media (width <= 600px) {
			.buttons a {
				text-align: center;
				width: 100%;
				max-width: 280px;
			}

			.panel-label {
				display: none;
			}

			figcaption {
				font-size: 0.8rem;
			}
		}

		.framework-section {
			padding: 0 0 3rem;
		}

		.framework-section h2 {
			margin: 0 0 0.55rem;
			font-size: clamp(1.55rem, 2.5vw, 1.75rem);
		}

		.framework-section p {
			margin: 0;
		}

		.viewer-gallery {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 0.75rem;
			margin-top: 1.25rem;
		}

		.viewer-gallery figure {
			margin: 0;
			aspect-ratio: 5 / 11;
			border: 1px solid var(--border);
			background: #ffffff;
			overflow: hidden;
		}

		.viewer-gallery img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: right bottom;
		}

		@media (width <= 700px) {
			.viewer-gallery {
				grid-template-columns: 1fr;
			}

			.viewer-gallery figure {
				aspect-ratio: 517 / 507;
			}
		}

	</style>
</Layout>
