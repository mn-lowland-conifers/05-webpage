---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
	<section class="hero">
		<h1>Minnesota Peatland Carbon Mapping</h1>
		<p class="subtitle">Statewide peatland probability, depth, and carbon stock mapping.</p>

		<div class="button-row">
			<a class="button" href="/map/">Explore Maps</a>
			<a class="button" href="/database/">Explore Database</a>
			<a class="button" href="/resources/">Read Documentation</a>
		</div>
	</section>

	<style>
		.hero {
			text-align: center;
			padding: 1.5rem 0 2.5rem;
		}

		.hero h1 {
			font-size: 1.95rem;
			margin-bottom: 0.4rem;
		}

		.subtitle {
			font-style: italic;
			color: #5a5a5a;
			margin-bottom: 1.75rem;
		}
	</style>
</Layout>
